# MySQL connection string. Replace user, password and database name.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/nightclub"

# Random secret for signing sessions. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Credentials for the first super admin created by the seed. Choose your own; never commit .env.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Public base URL of the site (used for metadata).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
